# ---------------------------------------------------------------------------
# bot-review environment configuration
# Copy to .env and fill in values. Never commit the real .env file.
# ---------------------------------------------------------------------------

# Which job group to run: static | tests | deps | ai | report
CHECK_JOB=static

# Directory where check results / reports are written
RESULT_DIR=bot-results

# --- GitHub (set by Actions; only needed locally for reporting) -----------
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_EVENT_NAME=
GITHUB_EVENT_PATH=
GITHUB_SHA=
GITHUB_REF_NAME=
GITHUB_BASE_REF=
GITHUB_HEAD_REF=

# --- Groq AI review ---------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
# Chunk the diff for the AI reviewer when it exceeds this many characters
AI_MAX_DIFF_CHARS=20000

# --- Gates ------------------------------------------------------------------
# Run integration tests (they hit real infra) — true | false
RUN_INTEGRATION=false
# Path passed to `bun test` for integration tests
INTEGRATION_TEST_PATH=test/integration
# Coverage floor; fails below this percentage
COVERAGE_THRESHOLD=80
# Scan installed packages for license fields — true | false
LICENSE_SCAN_ENABLED=false
# Whether AI findings can fail the run — true | false
AI_REVIEW_BLOCKING=false